FROM node:24

WORKDIR /app

COPY package.json package.json
COPY package-lock.json package-lock.json

RUN npm ci

FROM nginx:1.31

COPY nginx.conf /etc/nginx/conf.d/default.conf

WORKDIR /var/www/html

COPY --from=0 /app/node_modules .

RUN mkdir -p admin

COPY admin/style.css admin/style.css
COPY admin/tinymce.css admin/tinymce.css
COPY css css
COPY images images
COPY fonts fonts
COPY js js
