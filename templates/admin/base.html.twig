<html lang="en">
	<head>
		<title>{% block title %}{% endblock %} | {{ settings.site_name }} Admin</title>

		<meta charset="utf-8">

		<link href='https://fonts.googleapis.com/css?family=Playfair+Display:400,700,400italic,700italic'
			  rel='stylesheet' type='text/css'>
		<link href='https://fonts.googleapis.com/css?family=Open+Sans:400italic,600italic,700italic,400,600,700'
			  rel='stylesheet' type='text/css'>

		<link rel="stylesheet" href="/admin/style.css">

		<script src="/bower_components/jquery/dist/jquery.min.js"></script>

		<script type="text/javascript" src="/bower_components/tinymce/jquery.tinymce.min.js"></script>
		<script type="text/javascript" src="/bower_components/tinymce/tinymce.min.js"></script>

		<script type="text/javascript">
			$(document).ready(function() {
				tinymce.init({
					selector: ".wysiwyg",
					plugins: "code image media link table template",
					entity_encoding: "raw",
					paste_word_valid_elements: "b,strong,i,em,h1,h2,sup",
					paste_auto_cleanup_on_paste: true,
					paste_use_dialog: true,
					removed_menuitems: "newdocument",
					content_css: "tinymce.css",
					relative_urls: false,
					forced_root_block: "",
					style_formats: [
						{title: "Image Align Left", selector: "img", classes: "alignLeft"},
						{title: "Image Align Right", selector: "img", classes: "alignRight"},

						{title: "Button", selector: "a", classes: "button"}
					]
				});
			});
		</script>
	</head>
	<body>
		<nav>
			<ul>
				<li class="title"><a href="/admin/">{{ settings.site_name }} Admin</a></li>
				{% if current_page != "login" %}
					<li{% if current_page == "entries" %} class="active"{% endif %}>
					<a href="/admin/entries/"><span class="icon-reorder"></span> Entries</a>
					</li>
					<li{% if current_page == "pages" %} class="active"{% endif %}>
					<a href="/admin/pages/"><span class="icon-description"></span> Pages</a>
					</li>
					<li{% if current_page == "users" %} class="active"{% endif %}>
					<a href="/admin/users/"><span class="icon-people"></span> Users</a>
					</li>
					<li{% if current_page == "fields" %} class="active"{% endif %}>
					<a href="/admin/fields/"><span class="icon-reorder"></span> Fields</a>
					</li>
					<li{% if current_page == "user-settings" %} class="active"{% endif %}>
					<a href="/admin/user-settings/"><span class="icon-settings"></span> My Settings</a>
					</li>
					<li class="alignRight">
						<a href="/admin/logout/">Log Out ({{ username }})</a>
					</li>
				{% endif %}
			</ul>
		</nav>
		<section class="main">
			{% block content %}{% endblock %}
		</section>
		<footer>
			<div>&copy; Queen's University Biological Station 2015-2016. All rights reserved.</div>
		</footer>
	</body>
</html>
