<!DOCTYPE html>
<html lang="en">
	<head>
		<title>{% block title %}{% endblock %} | {{ settings.site_name }}</title>

		<meta charset="utf-8">

		<link href="https://fonts.googleapis.com/css?family=Playfair+Display:400,700,400italic,700italic"
			rel="stylesheet" type="text/css">
		<link href="https://fonts.googleapis.com/css?family=Open+Sans:400italic,600italic,700italic,400,600,700"
			rel="stylesheet" type="text/css">
		<link rel="stylesheet" href="/bower_components/jquery-ui/themes/smoothness/jquery-ui.min.css">

		<link rel="stylesheet" href="/css/style.css">

		<script src="/bower_components/jquery/dist/jquery.min.js"></script>
		<script src="/bower_components/jquery-ui/jquery-ui.min.js"></script>

		<script type="text/javascript">
			{% if settings.ga_tracking_id %}
			// Begin Google Analytics Tracking JS
			(function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
						(i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
					m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
			})(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

			ga('create', '{{ settings.ga_tracking_id }}', 'auto');
			ga('send', 'pageview');
			// End Google Analytics Tracking JS
			{% endif %}

			$(".help").each(function() {
				if($(this).children("div")[0].innerHTML == "") {
					$(this).css("display", "none");
				}
			});
		</script>

		{% block scripts %}{% endblock %}
	</head>
	<body>
		<div id="qubsBar" class="dark">
			<ul>
				<li><a href="http://queensu.ca/qubs">QUBS</a></li>
				<li><a href="https://elbowlakecentre.ca">ELEEC</a></li>
				<li><a href="http://dataverse.scholarsportal.info/dvn/dv/QUBS">QUBS Dataverse</a></li>
				<li><a href="https://opinicon.wordpress.com/">Opinicon Natural History</a></li>
				<li><a href="https://ecoadventurecamp.ca">Eco-Adventure Camp</a></li>
				<li class="active"><a href="/">Fowler Herbarium</a></li>
				<li><a href="http://fieldstations.ca">fieldstations.ca</a></li>
			</ul>
		</div>
		<header>
			<h1>{{ settings.site_name }}</h1>
			<nav>
				<ul>
					{% for page in menu_pages %}
						<li>
						{% if page.page_id == settings.home_page %}
							<a href="/"><span class="icon-{{ page.menu_icon }}"></span>
								{{ page.title }}</a>
						{% elseif page.page_id == settings.search_page %}
							<a href="/search/"><span class="icon-{{ page.menu_icon }}"></span>
								{{ page.title }}</a>
						{% else %}
							<a href="/page/{{ page.page_id }}/"><span class="icon-{{ page.menu_icon }}"></span>
								{{ page.title }}</a>
						{% endif %}
						</li>
					{% endfor %}
				</ul>
			</nav>
		</header>
		<section class="main">
			<div>
				{% block content %}{% endblock %}
			</div>
		</section>
		<footer>
			<div>
				<span>Copyright 2015-2017. All rights reserved.</span>
				<nav>
					<ul>
						{% for page in menu_pages %}
							<li>
								<a href="{{ page.routes }}"><span class="icon-{{ page.menu_icon }}"></span>
									{{ page.title }}</a>
							</li>
						{% endfor %}
					</ul>
				</nav>
				<hr>
				<address>
					<strong>Queen's University Biological Station</strong> <br>
					280 Queen's University Road <br>
					RR #1, Elgin, Ontario &nbsp; K0G 1E0 <br>
					<strong>Telephone:</strong> 613-359-5629
				</address>
			</div>
		</footer>
	</body>
</html>
