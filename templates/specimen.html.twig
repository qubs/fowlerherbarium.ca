{% extends "base.html.twig" %}

{% block title %}{{ specimen.genus }} {{ specimen.species }} ({{ specimen.accession }}){% endblock %}

{% block content %}
<button type="button" onclick="window.history.back();">&larr; Back</button>
<div class="specimenFull">
	<h3>{{ specimen.genus }} {{ specimen.species }}</h3>
	<table>
		<thead>
			<tr>
				<th width="30%">Field</th><th width="70%">Value</th>
			</tr>
		</thead>
		<tbody>
			{% for f in field_data %}
				<tr>
					<td>
						{{ f.label }}
						{% if f.help is not empty %}
							<div class="help"><div>{{ f.help }}</div></div>
						{% endif %}
					</td>
					<td>
						{#
							Don't bother rendering fields that are blank. This doesn't matter for text but for image and
						 	other field displays this could cause display issues.
						 #}
						{% if specimen[f.field] is not empty %}
							{% if f.field != "image" %}
								{{ specimen[f.field] }}
							{% else %}
								<img src="/uploads/{{ specimen[f.field] }}">
							{% endif %}
						{% endif %}
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table><div class="wiki">
		<h4>From Wikipedia</h4>
		<iframe src="https://en.m.wikipedia.org/wiki/{{ (specimen.genus ~ " " ~ specimen.species)|replace({" ": "_"}) }}"
				frameborder="0"></iframe>
	</div>
</div>
{% endblock %}

